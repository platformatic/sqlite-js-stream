{
  "name": "@platformatic/sqlite-js-stream-pg",
  "version": "0.2.1",
  "description": "PostgreSQL upload strategy (replica client) for @platformatic/sqlite-js-stream",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "Matteo Collina",
  "homepage": "https://github.com/platformatic/sqlite-js-stream/tree/main/packages/backend-pg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/sqlite-js-stream.git",
    "directory": "packages/backend-pg"
  },
  "bugs": {
    "url": "https://github.com/platformatic/sqlite-js-stream/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
