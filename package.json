{
  "name": "sqlite-js-stream",
  "version": "0.5.0",
  "description": "Monorepo for @platformatic/sqlite-js-stream and its addons",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "Matteo Collina",
  "homepage": "https://github.com/platformatic/sqlite-js-stream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/sqlite-js-stream.git"
  },
  "bugs": {
    "url": "https://github.com/platformatic/sqlite-js-stream/issues"
  },
  "scripts": {
    "build": "pnpm --filter @platformatic/sqlite-js-stream build",
    "pretypecheck": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:all": "pnpm typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest:all": "pnpm build",
    "test:all": "pnpm -r --filter '!@platformatic/sqlite-js-stream-paged-vfs' test",
    "test:paged-vfs": "pnpm --filter @platformatic/sqlite-js-stream-paged-vfs build:native && pnpm --filter @platformatic/sqlite-js-stream-paged-vfs build && pnpm --filter @platformatic/sqlite-js-stream-paged-vfs test && node --test packages/sqlite-js-stream/test/integration/paged-restore.test.ts",
    "bench": "pnpm --filter @platformatic/sqlite-js-stream bench",
    "golden:go": "cd packages/sqlite-js-stream/tools/golden && go run ."
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^9.39.5",
    "neostandard": "^0.14.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "sqlite",
    "litestream",
    "replication",
    "backup",
    "ltx",
    "disaster-recovery",
    "monorepo"
  ]
}
