{
  "name": "@platformatic/sqlite-js-stream",
  "version": "0.1.4",
  "description": "Node.js port of Litestream: SQLite streaming replication & disaster recovery via LTX files",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "Matteo Collina",
  "homepage": "https://github.com/platformatic/sqlite-js-stream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/sqlite-js-stream.git"
  },
  "bugs": {
    "url": "https://github.com/platformatic/sqlite-js-stream/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "pretypecheck": "pnpm build",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "golden:go": "cd tools/golden && go run .",
    "pretest:all": "pnpm build",
    "test:all": "pnpm test && pnpm -r test",
    "typecheck:all": "pnpm typecheck",
    "bench": "node bench/bench-sync-restore.ts"
  },
  "dependencies": {
    "lz4js": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "neostandard": "^0.14.0",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "sqlite",
    "litestream",
    "replication",
    "backup",
    "ltx",
    "disaster-recovery"
  ]
}
