    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@platformatic/sqlite-js-stream": "workspace:*",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
