# Dependencies
node_modules/

# Rust build output and native addons (packages/sqlite-js-stream-paged-vfs),
# and the platform packages the release workflow creates from them
target/
*.node
packages/sqlite-js-stream-paged-vfs/artifacts/
packages/sqlite-js-stream-paged-vfs/npm/

# Build / output
dist/
coverage/
*.tsbuildinfo

# Test artifacts
test/.tmp/
*.db
*.db-wal
*.db-shm
*.tmp

# Generated LTX test fixtures (produced at runtime)
testdata/golden/*.ltx
testdata/local/

# Editor / OS
.DS_Store
*.log
npm-debug.log*
*.tgz

# Stray/transpiled output (tsc emits to dist/, not src/)
src/**/*.js
src/**/*.d.ts.map

# Environment
.env
.env.*
!.env.example
